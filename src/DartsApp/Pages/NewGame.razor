@page "/new"
@page "/new/{ModeName}"
@inject DataService Data
@inject GameSession Session
@inject LocalStore Store
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject UiState Ui

<PageTitle>Neues Spiel · Darts</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Neues Spiel</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12">
        @foreach (var group in GameModes.All.GroupBy(m => m.Training))
        {
            <MudText Typo="Typo.subtitle2" Class="@(group.Key ? "mt-3 mb-1" : "mb-1")">@(group.Key ? "Training" : "Spiele")</MudText>
            <div class="mode-grid">
                @foreach (var info in group)
                {
                    <MudPaper Class="@($"mode-tile pa-3 {(info.Mode == _settings.Mode ? "selected" : "")}")" Elevation="@(info.Mode == _settings.Mode ? 4 : 1)"
                              @onclick="() => SelectMode(info.Mode)">
                        <MudText Typo="Typo.subtitle1"><b>@info.Name</b></MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@info.Short</MudText>
                    </MudPaper>
                }
            </div>
        }
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6">@ModeInfo.Name</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@ModeInfo.Description</MudText>

            @switch (_settings.Mode)
            {
                case GameMode.X01:
                case GameMode.SuddenDeath:
                    <MudText Typo="Typo.subtitle2">Startpunkte</MudText>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var score in new[] { 101, 301, 501, 701, 1001 })
                        {
                            var value = score;
                            <MudChip T="int" Color="@(value == _settings.StartScore ? Color.Primary : Color.Default)"
                                     Variant="@(value == _settings.StartScore ? Variant.Filled : Variant.Outlined)"
                                     OnClick="@(() => Update(s => s with { StartScore = value }))">@value</MudChip>
                        }
                    </div>
                    <MudNumericField T="int" Label="Eigene Startpunkte" Min="2" Max="9999" Value="@_settings.StartScore" ValueChanged="@(v => Update(s => s with { StartScore = Math.Clamp(v, 2, 9999) }))" Class="mt-2" />
                    <MudGrid Spacing="2" Class="mt-1">
                        <MudItem xs="6">
                            <MudSelect T="InOutRule" Label="Einstieg" Value="@_settings.InRule" ValueChanged="@(v => Update(s => s with { InRule = v }))">
                                <MudSelectItem Value="InOutRule.Single">Single In</MudSelectItem>
                                <MudSelectItem Value="InOutRule.Double">Double In</MudSelectItem>
                                <MudSelectItem Value="InOutRule.Master">Master In</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6">
                            <MudSelect T="InOutRule" Label="Ausstieg" Value="@_settings.OutRule" ValueChanged="@(v => Update(s => s with { OutRule = v }))">
                                <MudSelectItem Value="InOutRule.Single">Single Out</MudSelectItem>
                                <MudSelectItem Value="InOutRule.Double">Double Out</MudSelectItem>
                                <MudSelectItem Value="InOutRule.Master">Master Out</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="int" Label="Legs (First to)" Min="1" Max="21" Value="@_settings.LegsToWin" ValueChanged="@(v => Update(s => s with { LegsToWin = Math.Clamp(v, 1, 21) }))" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="int" Label="Sets (First to)" Min="1" Max="13" Value="@_settings.SetsToWin" ValueChanged="@(v => Update(s => s with { SetsToWin = Math.Clamp(v, 1, 13) }))"
                                             HelperText="1 = ohne Sets" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudNumericField T="int" Label="Aufnahmelimit pro Leg" Min="@(_settings.Mode == GameMode.SuddenDeath ? 1 : 0)" Max="50" Value="@_settings.TurnLimit"
                                             ValueChanged="@(v => Update(s => s with { TurnLimit = Math.Clamp(v, s.Mode == GameMode.SuddenDeath ? 1 : 0, 50) }))"
                                             HelperText="@(_settings.Mode == GameMode.SuddenDeath ? "Nach dem Limit gewinnt der kleinste Rest das Leg" : "0 = ohne Limit")" />
                        </MudItem>
                    </MudGrid>
                    break;

                case GameMode.NineLives:
                    <MudNumericField T="int" Label="Leben" Min="1" Max="20" Value="@_settings.KillerLives" ValueChanged="@(v => Update(s => s with { KillerLives = Math.Clamp(v, 1, 20) }))" />
                    break;

                case GameMode.AllFives:
                    <MudNumericField T="int" Label="Zielpunktzahl" Min="5" Max="200" Value="@_settings.FivesTarget" ValueChanged="@(v => Update(s => s with { FivesTarget = Math.Clamp(v, 5, 200) }))"
                                     HelperText="Klassisch 51 · Punkte = Summe ÷ 5" />
                    break;

                case GameMode.HareAndHounds:
                case GameMode.Prisoner:
                case GameMode.DoublesLadder:
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine weiteren Einstellungen nötig.</MudText>
                    break;

                case GameMode.Cricket:
                    <MudSelect T="CricketVariant" Label="Variante" Value="@_settings.CricketVariant" ValueChanged="@(v => Update(s => s with { CricketVariant = v }))" Class="mb-2">
                        <MudSelectItem Value="CricketVariant.Standard">Standard (15 bis 20, Bull)</MudSelectItem>
                        <MudSelectItem Value="CricketVariant.Tactics">Tactics (10 bis 20, Bull)</MudSelectItem>
                        <MudSelectItem Value="CricketVariant.Random">Random (6 zufällige Zahlen, Bull)</MudSelectItem>
                        <MudSelectItem Value="CricketVariant.MickeyMouse">Mickey Mouse (12 bis 20, Doppel, Triple, Bull)</MudSelectItem>
                    </MudSelect>
                    <MudSwitch T="bool" Value="@_settings.CutThroat" ValueChanged="@(v => Update(s => s with { CutThroat = v }))" Color="Color.Primary" Label="Cut Throat (Punkte gehen an die Gegner)" />
                    <MudNumericField T="int" Label="Rundenlimit" Min="0" Max="99" Value="@_settings.Rounds" ValueChanged="@(v => Update(s => s with { Rounds = Math.Clamp(v, 0, 99) }))" HelperText="0 = unbegrenzt" />
                    break;

                case GameMode.AroundTheClock:
                    <MudSelect T="AroundTheClockHit" Label="Gültige Treffer" Value="@_settings.ClockHit" ValueChanged="@(v => Update(s => s with { ClockHit = v }))">
                        <MudSelectItem Value="AroundTheClockHit.Any">Alle Felder (Single, Double, Triple)</MudSelectItem>
                        <MudSelectItem Value="AroundTheClockHit.DoubleOnly">Nur Doppel</MudSelectItem>
                        <MudSelectItem Value="AroundTheClockHit.TripleOnly">Nur Triple</MudSelectItem>
                    </MudSelect>
                    <MudSwitch T="bool" Value="@_settings.ClockIncludeBull" ValueChanged="@(v => Update(s => s with { ClockIncludeBull = v }))" Color="Color.Primary" Label="Bull zum Abschluss" Class="mt-2" />
                    @if (_settings.ClockHit == AroundTheClockHit.Any)
                    {
                        <MudSwitch T="bool" Value="@_settings.ClockMultiplierSkips" ValueChanged="@(v => Update(s => s with { ClockMultiplierSkips = v }))" Color="Color.Primary" Label="Double/Triple überspringt Zahlen" />
                    }
                    break;

                case GameMode.Shanghai:
                    <MudNumericField T="int" Label="Runden" Min="1" Max="20" Value="@_settings.Rounds" ValueChanged="@(v => Update(s => s with { Rounds = Math.Clamp(v, 1, 20) }))" HelperText="Klassisch 7, lang 20" />
                    break;

                case GameMode.Bobs27:
                    <MudSwitch T="bool" Value="@_settings.Bobs27Elimination" ValueChanged="@(v => Update(s => s with { Bobs27Elimination = v }))" Color="Color.Primary" Label="Ausscheiden bei 0 Punkten oder weniger" />
                    break;

                case GameMode.Checkout121:
                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <MudNumericField T="int" Label="Startwert" Min="2" Max="170" Value="@_settings.CheckoutStart" ValueChanged="@(v => Update(s => s with { CheckoutStart = Math.Clamp(v, 2, 170) }))" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="int" Label="Versuche" Min="1" Max="100" Value="@_settings.CheckoutAttempts" ValueChanged="@(v => Update(s => s with { CheckoutAttempts = Math.Clamp(v, 1, 100) }))" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="int" Label="Aufnahmen pro Versuch" Min="1" Max="10" Value="@_settings.CheckoutTurnsPerAttempt" ValueChanged="@(v => Update(s => s with { CheckoutTurnsPerAttempt = Math.Clamp(v, 1, 10) }))"
                                             HelperText="@($"= {_settings.CheckoutTurnsPerAttempt * 3} Darts")" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudSelect T="InOutRule" Label="Ausstieg" Value="@_settings.OutRule" ValueChanged="@(v => Update(s => s with { OutRule = v }))">
                                <MudSelectItem Value="InOutRule.Double">Double Out</MudSelectItem>
                                <MudSelectItem Value="InOutRule.Master">Master Out</MudSelectItem>
                                <MudSelectItem Value="InOutRule.Single">Single Out</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudSelect T="CheckoutFailRule" Label="Bei verpasstem Checkout" Value="@_settings.CheckoutOnFail" ValueChanged="@(v => Update(s => s with { CheckoutOnFail = v }))">
                                <MudSelectItem Value="CheckoutFailRule.Stay">Ziel bleibt gleich</MudSelectItem>
                                <MudSelectItem Value="CheckoutFailRule.MinusOne">Ziel sinkt um 1</MudSelectItem>
                                <MudSelectItem Value="CheckoutFailRule.Reset">Zurück auf Startwert</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                    break;

                case GameMode.HighScore:
                    <MudNumericField T="int" Label="Runden" Min="1" Max="50" Value="@_settings.Rounds" ValueChanged="@(v => Update(s => s with { Rounds = Math.Clamp(v, 1, 50) }))" />
                    break;

                case GameMode.Killer:
                    <MudNumericField T="int" Label="Leben" Min="1" Max="9" Value="@_settings.KillerLives" ValueChanged="@(v => Update(s => s with { KillerLives = Math.Clamp(v, 1, 9) }))"
                                     HelperText="Die Zahlen werden beim Start zufällig verteilt." />
                    break;

                case GameMode.HalveIt:
                    <MudSelect T="HalveItVariant" Label="Variante" Value="@_settings.HalveItVariant" ValueChanged="@(v => Update(s => s with { HalveItVariant = v }))">
                        <MudSelectItem Value="HalveItVariant.Classic">Klassisch (9 Runden, Start 40)</MudSelectItem>
                        <MudSelectItem Value="HalveItVariant.Bermuda">Bermuda Triangle (13 Runden, Start 0)</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        Ziele: @(_settings.HalveItVariant == HalveItVariant.Bermuda
                                   ? "12 · 13 · 14 · Doppel · 15 · 16 · 17 · Triple · 18 · 19 · 20 · 25 · Bullseye"
                                   : "15 · 16 · Doppel · 17 · 18 · Triple · 19 · 20 · Bull")
                    </MudText>
                    break;

                case GameMode.Baseball:
                    <MudNumericField T="int" Label="Innings" Min="1" Max="20" Value="@_settings.Rounds" ValueChanged="@(v => Update(s => s with { Rounds = Math.Clamp(v, 1, 20) }))" HelperText="Klassisch 9" />
                    break;

                case GameMode.Gotcha:
                    <MudNumericField T="int" Label="Zielpunktzahl" Min="50" Max="1001" Value="@_settings.GotchaTarget" ValueChanged="@(v => Update(s => s with { GotchaTarget = Math.Clamp(v, 50, 1001) }))" />
                    break;

                case GameMode.Golf:
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var holes in new[] { 9, 18 })
                        {
                            var value = holes;
                            <MudChip T="int" Color="@(value == _settings.Rounds ? Color.Primary : Color.Default)"
                                     Variant="@(value == _settings.Rounds ? Variant.Filled : Variant.Outlined)"
                                     OnClick="@(() => Update(s => s with { Rounds = value }))">@value Löcher</MudChip>
                        }
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">Triple = 1 · Double = 2 · Single = 3 · kein Treffer = 5 Schläge</MudText>
                    break;

                case GameMode.Scram:
                case GameMode.TicTacToe:
                case GameMode.JdcChallenge:
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine weiteren Einstellungen nötig.</MudText>
                    break;

                case GameMode.Football:
                    <MudNumericField T="int" Label="Tore zum Sieg" Min="1" Max="30" Value="@_settings.FootballGoals" ValueChanged="@(v => Update(s => s with { FootballGoals = Math.Clamp(v, 1, 30) }))" />
                    break;

                case GameMode.CheckoutRoulette:
                case GameMode.BigFinish:
                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <MudNumericField T="int" Label="Von" Min="2" Max="170" Value="@_settings.RouletteMin" ValueChanged="@(v => Update(s => s with { RouletteMin = Math.Clamp(v, 2, 170) }))" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="int" Label="Bis" Min="2" Max="170" Value="@_settings.RouletteMax" ValueChanged="@(v => Update(s => s with { RouletteMax = Math.Clamp(v, 2, 170) }))" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="int" Label="Versuche" Min="1" Max="100" Value="@_settings.CheckoutAttempts" ValueChanged="@(v => Update(s => s with { CheckoutAttempts = Math.Clamp(v, 1, 100) }))" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="int" Label="Aufnahmen pro Versuch" Min="1" Max="3" Value="@_settings.CheckoutTurnsPerAttempt" ValueChanged="@(v => Update(s => s with { CheckoutTurnsPerAttempt = Math.Clamp(v, 1, 3) }))"
                                             HelperText="@($"= {_settings.CheckoutTurnsPerAttempt * 3} Darts")" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudSelect T="InOutRule" Label="Ausstieg" Value="@_settings.OutRule" ValueChanged="@(v => Update(s => s with { OutRule = v }))">
                                <MudSelectItem Value="InOutRule.Double">Double Out</MudSelectItem>
                                <MudSelectItem Value="InOutRule.Master">Master Out</MudSelectItem>
                                <MudSelectItem Value="InOutRule.Single">Single Out</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                    break;

                case GameMode.Catch40:
                    <MudSelect T="InOutRule" Label="Ausstieg" Value="@_settings.OutRule" ValueChanged="@(v => Update(s => s with { OutRule = v }))">
                        <MudSelectItem Value="InOutRule.Double">Double Out</MudSelectItem>
                        <MudSelectItem Value="InOutRule.Master">Master Out</MudSelectItem>
                        <MudSelectItem Value="InOutRule.Single">Single Out</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">2 Darts = 3 Punkte · 3 Darts = 2 Punkte · 4–6 Darts = 1 Punkt</MudText>
                    break;

                case GameMode.ScoringDrill:
                    <MudText Typo="Typo.subtitle2">Zielfeld</MudText>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var field in new[] { "T20", "T19", "T18", "T17", "D20", "D16", "BULL" })
                        {
                            var value = field;
                            <MudChip T="string" Color="@(value == _settings.DrillTarget ? Color.Primary : Color.Default)"
                                     Variant="@(value == _settings.DrillTarget ? Variant.Filled : Variant.Outlined)"
                                     OnClick="@(() => Update(s => s with { DrillTarget = value }))">@(value == "BULL" ? "Bull" : value)</MudChip>
                        }
                    </div>
                    <MudNumericField T="int" Label="Aufnahmen" Min="1" Max="100" Value="@_settings.Rounds" ValueChanged="@(v => Update(s => s with { Rounds = Math.Clamp(v, 1, 100) }))"
                                     HelperText="@($"= {_settings.Rounds * 3} Darts")" Class="mt-2" />
                    break;

                case GameMode.BullTraining:
                    <MudNumericField T="int" Label="Aufnahmen" Min="1" Max="100" Value="@_settings.Rounds" ValueChanged="@(v => Update(s => s with { Rounds = Math.Clamp(v, 1, 100) }))"
                                     HelperText="@($"= {_settings.Rounds * 3} Darts · 25 = 1 Punkt, Bullseye = 2 Punkte")" />
                    break;
            }

            @if (ModeInfo.SupportsFastInput)
            {
                var fastAvailable = ModeInfo.FastInputAvailable(_settings);
                <MudDivider Class="my-3" />
                <MudSwitch T="bool" Value="@(_settings.FastInput && fastAvailable)" ValueChanged="@(v => Update(s => s with { FastInput = v }))"
                           Disabled="@(!fastAvailable)" Color="Color.Primary" Label="Schnelleingabe (Fast Mode)" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                    @(fastAvailable
                        ? "Statt jeden Dart einzeln tippst du nur die Summe der Aufnahme (z.B. 100). Checkt die Summe aus, fragt die App, mit wie vielen Darts. Statistiken wie Average und 180er funktionieren weiter, Einzeltreffer werden nicht erfasst."
                        : "Mit Double oder Master In nicht möglich – ob der Einstieg gültig war, lässt sich aus der Summe nicht ablesen.")
                </MudText>
            }

            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-3 d-block">@_settings.Describe()</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <div class="d-flex align-center">
                <MudText Typo="Typo.h6">Spieler (@_selected.Count)</MudText>
                <MudSpacer />
                <MudTooltip Text="Reihenfolge zufällig">
                    <MudIconButton Icon="@Icons.Material.Filled.Shuffle" Disabled="@(_selected.Count < 2)" OnClick="Shuffle" />
                </MudTooltip>
            </div>

            @if (_selected.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary my-2">Wähle unten Spieler aus oder füge einen Gast hinzu.</MudText>
            }
            else
            {
                <MudList T="PlayerRef" Dense="true" Class="py-0">
                    @for (var i = 0; i < _selected.Count; i++)
                    {
                        var index = i;
                        var player = _selected[i];
                        @if (_teamMode && index % _teamSize == 0)
                        {
                            <MudText Typo="Typo.overline" Class="d-block mt-2 mud-text-secondary">Team @(index / _teamSize + 1)</MudText>
                        }
                        <MudListItem T="PlayerRef">
                            <div class="d-flex align-center">
                                <MudAvatar Size="Size.Small" Color="@(index == 0 ? Color.Primary : Color.Default)" Class="mr-3">@(index + 1)</MudAvatar>
                                @if (player.Bot is { } bot)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" Color="Color.Secondary" Class="mr-1" />
                                    <MudText>@player.Name</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ml-1">~@bot.ApproxAverage() Ø</MudChip>
                                }
                                else
                                {
                                    <MudText>@player.Name @(player.Id is null ? "(Gast)" : "")</MudText>
                                }
                                <MudSpacer />
                                @if (HandicapActive)
                                {
                                    <MudNumericField T="int" Value="@(player.StartScore ?? _settings.StartScore)" Min="2" Max="9999" Margin="Margin.Dense"
                                                     ValueChanged="@(v => SetStartScore(index, v))" Style="max-width:90px" Class="mr-1"
                                                     aria-label="Startwert" HideSpinButtons="true" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" Disabled="@(index == 0)" OnClick="() => Move(index, -1)" />
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Disabled="@(index == _selected.Count - 1)" OnClick="() => Move(index, 1)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _selected.RemoveAt(index)" />
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }

            <div class="d-flex flex-wrap align-center gap-3 mt-2">
                <MudSwitch T="bool" @bind-Value="_teamMode" Color="Color.Primary" Label="Teams" />
                @if (_teamMode)
                {
                    <MudSelect T="int" @bind-Value="_teamSize" Label="Spieler pro Team" Margin="Margin.Dense" Style="max-width:150px">
                        <MudSelectItem T="int" Value="2">2 (Doppel)</MudSelectItem>
                        <MudSelectItem T="int" Value="3">3</MudSelectItem>
                        <MudSelectItem T="int" Value="4">4</MudSelectItem>
                    </MudSelect>
                }
                @if (IsX01Mode && !_teamMode)
                {
                    <MudSwitch T="bool" @bind-Value="_handicap" Color="Color.Primary" Label="Handicap (Startwert je Spieler)" />
                }
            </div>
            @if (_teamMode)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                    Die Teams werden in der Reihenfolge der Liste gebildet; die Mitglieder werfen abwechselnd und spielen auf einen gemeinsamen Spielstand.
                </MudText>
            }

            <MudDivider Class="my-3" />

            @if (_available.Count > 0)
            {
                <MudText Typo="Typo.subtitle2">Spielerliste</MudText>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var player in _available)
                    {
                        var isSelected = _selected.Any(s => s.Id == player.Id);
                        <MudChip T="string" Color="@(isSelected ? Color.Primary : Color.Default)" Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                 Icon="@(player.IsSelf ? Icons.Material.Filled.Person : null)" OnClick="() => TogglePlayer(player)">@player.Name</MudChip>
                    }
                </div>
            }

            <div class="d-flex align-center gap-2">
                <MudTextField @bind-Value="_guestName" Label="Name hinzufügen" MaxLength="40" Immediate="true"
                              OnKeyDown="@(e => e.Key == "Enter" ? AddGuestAsync() : Task.CompletedTask)" />
                <MudButton Variant="Variant.Outlined" OnClick="AddGuestAsync" Disabled="@string.IsNullOrWhiteSpace(_guestName)">Hinzufügen</MudButton>
            </div>
            <MudCheckBox T="bool" @bind-Value="_saveGuest" Label="@(_private ? "In Spielerliste speichern (bei privaten Spielen aus)" : "In Spielerliste speichern")" Disabled="_private" Dense="true" Size="Size.Small" />

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2">Computergegner</MudText>
            <div class="d-flex align-center gap-2">
                <MudSelect T="BotLevel" @bind-Value="_botLevel" Label="Schwierigkeit" Margin="Margin.Dense">
                    @foreach (var level in BotLevels.All)
                    {
                        <MudSelectItem T="BotLevel" Value="@level">@level.Name() (Ø ~@level.ApproxAverage())</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SmartToy" OnClick="AddBot">Hinzufügen</MudButton>
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Ø = ungefährer 3-Dart-Average in X01. Der Computer spielt in jedem Modus mit passender Taktik.</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-3 d-flex align-center flex-wrap gap-2" Elevation="1">
            <MudIcon Icon="@(_private ? Icons.Material.Filled.VisibilityOff : Icons.Material.Outlined.Visibility)" Color="@(_private ? Color.Primary : Color.Default)" />
            <MudSwitch T="bool" Value="_private" ValueChanged="SetPrivateAsync" Color="Color.Primary" Label="Privates Spiel – nicht speichern" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @(_private
                    ? "Das Spiel wird weder im Konto noch im Browser gespeichert und erscheint nicht in Verlauf oder Statistik. Neuladen der Seite beendet es."
                    : "Spiele werden " + (Data.IsCloud ? "in deinem Konto" : "in diesem Browser") + " gespeichert.")
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" Class="d-flex justify-end gap-2">
        @if (_teamMode && _selected.Count % _teamSize != 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary align-self-center">Für Teams zu je @_teamSize Spielern muss die Spielerzahl durch @_teamSize teilbar sein.</MudText>
        }
        else if (Units < ModeInfo.MinPlayers)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary align-self-center">@ModeInfo.Name braucht @(ExactPlayers ? "genau" : "mindestens") @ModeInfo.MinPlayers @UnitName – füge Mitspieler oder Computergegner hinzu.</MudText>
        }
        else if (Units > ModeInfo.MaxPlayers)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary align-self-center">@ModeInfo.Name wird mit @(ExactPlayers ? "genau" : "höchstens") @ModeInfo.MaxPlayers @UnitName gespielt – entferne Spieler aus der Liste.</MudText>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.PlayArrow"
                   Disabled="@(!PlayerCountValid)" OnClick="StartAsync">Spiel starten</MudButton>
    </MudItem>
</MudGrid>

@code {
    private const string LastSetupKey = "darts.lastSetup";

    private sealed class LastSetup
    {
        public Dictionary<GameMode, GameSettings> Settings { get; set; } = new();
        public GameMode Mode { get; set; }
        public List<PlayerRef> Players { get; set; } = [];
    }

    [Parameter] public string? ModeName { get; set; }

    private LastSetup _last = new();
    private GameSettings _settings = GameSettings.DefaultFor(GameMode.X01);
    private List<PlayerRef> _selected = [];
    private IReadOnlyList<Player> _available = [];
    private string _guestName = "";
    private bool _saveGuest = true;
    private BotLevel _botLevel = BotLevel.Intermediate;

    private GameModeInfo ModeInfo => GameModes.Get(_settings.Mode);
    private bool ExactPlayers => ModeInfo.MinPlayers == ModeInfo.MaxPlayers;
    private bool _teamMode;
    private int _teamSize = 2;
    private bool _handicap;
    private bool _private;

    private async Task SetPrivateAsync(bool value)
    {
        _private = value;
        await Ui.SetPrivateGamesAsync(value);
    }

    private int MaxListPlayers => _teamMode ? GameEngine.MaxPlayers * _teamSize : GameEngine.MaxPlayers;

    private bool IsX01Mode => _settings.Mode is GameMode.X01 or GameMode.SuddenDeath;
    private bool HandicapActive => _handicap && IsX01Mode && !_teamMode;

    /// <summary>Anzahl der "Spieler" im Spiel – bei Teams die Anzahl der Teams.</summary>
    private int Units => _teamMode ? _selected.Count / _teamSize : _selected.Count;
    private string UnitName => _teamMode ? "Teams" : "Spieler";

    private bool PlayerCountValid =>
        (!_teamMode || (_selected.Count > 0 && _selected.Count % _teamSize == 0))
        && Units >= ModeInfo.MinPlayers && Units <= ModeInfo.MaxPlayers;

    private void SetStartScore(int index, int value)
    {
        var start = Math.Clamp(value, 2, 9999);
        _selected[index] = _selected[index] with { StartScore = start == _settings.StartScore ? null : start };
    }

    /// <summary>Spieler bzw. Teams in Spielreihenfolge; Handicaps nur, wenn aktiv.</summary>
    private List<PlayerRef> BuildPlayers()
    {
        var players = _selected.Select(p => HandicapActive ? p : p with { StartScore = null }).ToList();
        if (!_teamMode) return players;
        return players.Chunk(_teamSize).Select(members => PlayerRef.Team(members)).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        _private = Ui.PrivateGames;
        _last = await Store.GetAsync<LastSetup>(LastSetupKey) ?? new LastSetup();

        try
        {
            _available = await Data.GetPlayersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Spieler konnten nicht geladen werden: {ex.Message}", Severity.Warning);
        }

        // Zuletzt verwendete Spieler, sofern noch vorhanden; sonst der Benutzer selbst.
        _selected = _last.Players
            .Where(p => p.Id is null || _available.Any(a => a.Id == p.Id))
            .Select(p => p.Id is { } id ? new PlayerRef(id, _available.First(a => a.Id == id).Name) : p)
            .ToList();
        if (_selected.Count == 0 && _available.FirstOrDefault(p => p.IsSelf) is { } self)
            _selected.Add(new PlayerRef(self.Id, self.Name));

        SelectMode(Enum.TryParse<GameMode>(ModeName, true, out var mode) ? mode : _last.Mode);
    }

    private string? _loadedModeName;

    /// <summary>Wechsel zwischen /new/X01 und /new/Cricket usw. ohne neues Laden der Seite.</summary>
    protected override void OnParametersSet()
    {
        // Läuft erst nach OnInitializedAsync; beim ersten Aufruf ist der Modus also schon gesetzt.
        if (_loadedModeName == ModeName) return;
        _loadedModeName = ModeName;
        if (Enum.TryParse<GameMode>(ModeName, true, out var mode) && mode != _settings.Mode) SelectMode(mode);
    }

    private void SelectMode(GameMode mode) =>
        _settings = _last.Settings.TryGetValue(mode, out var s) ? s with { Mode = mode } : GameSettings.DefaultFor(mode);

    private void Update(Func<GameSettings, GameSettings> change) => _settings = change(_settings);

    private void TogglePlayer(Player player)
    {
        var existing = _selected.FindIndex(s => s.Id == player.Id);
        if (existing >= 0)
            _selected.RemoveAt(existing);
        else if (_selected.Count < MaxListPlayers)
            _selected.Add(new PlayerRef(player.Id, player.Name));
        else
            Snackbar.Add($"Maximal {MaxListPlayers} Spieler", Severity.Warning);
    }

    private async Task AddGuestAsync()
    {
        var name = _guestName.Trim();
        if (name.Length == 0) return;
        if (_selected.Count >= MaxListPlayers)
        {
            Snackbar.Add($"Maximal {MaxListPlayers} Spieler", Severity.Warning);
            return;
        }

        if (_saveGuest && !_private)
        {
            try
            {
                var existing = _available.FirstOrDefault(p => string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase));
                var player = existing ?? await Data.AddPlayerAsync(name);
                _available = await Data.GetPlayersAsync();
                if (_selected.All(s => s.Id != player.Id)) _selected.Add(new PlayerRef(player.Id, player.Name));
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Spieler konnte nicht gespeichert werden: {ex.Message}", Severity.Error);
                _selected.Add(new PlayerRef(null, name));
            }
        }
        else
        {
            _selected.Add(new PlayerRef(null, name));
        }

        _guestName = "";
    }

    private void AddBot()
    {
        if (_selected.Count >= MaxListPlayers)
        {
            Snackbar.Add($"Maximal {MaxListPlayers} Spieler", Severity.Warning);
            return;
        }

        var baseName = $"Computer ({_botLevel.Name()})";
        var name = baseName;
        for (var i = 2; _selected.Any(p => p.Name == name); i++) name = $"{baseName} {i}";
        _selected.Add(new PlayerRef(null, name, _botLevel));
    }

    private void Move(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _selected.Count) return;
        (_selected[index], _selected[target]) = (_selected[target], _selected[index]);
    }

    private void Shuffle() => _selected = _selected.OrderBy(_ => Random.Shared.Next()).ToList();

    private async Task StartAsync()
    {
        if (!PlayerCountValid) return;

        if (Session.HasActiveGame)
        {
            var confirm = await DialogService.ShowMessageBoxAsync("Laufendes Spiel",
                "Es läuft noch ein Spiel. Soll es verworfen und ein neues gestartet werden?", yesText: "Neues Spiel", cancelText: "Abbrechen");
            if (confirm != true) return;
        }

        try
        {
            var settings = _settings with { FastInput = _settings.FastInput && ModeInfo.FastInputAvailable(_settings) };
            await Session.StartAsync(settings, BuildPlayers(), _private);
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        // Private Spiele hinterlassen nichts im Browser – auch nicht die zuletzt verwendeten Spieler.
        if (_private)
        {
            Navigation.NavigateTo("play");
            return;
        }

        _last.Mode = _settings.Mode;
        _last.Settings[_settings.Mode] = _settings;
        _last.Players = _selected.ToList();
        await Store.SetAsync(LastSetupKey, _last);

        Navigation.NavigateTo("play");
    }
}
