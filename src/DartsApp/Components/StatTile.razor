<MudPaper Class="@($"stat-tile pa-3 {(Highlight ? "highlight" : "")}")" Elevation="1">
    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Label</MudText>
    <div class="stat-value">@Value</div>
    @if (Sub is not null)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Sub</MudText>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Sub { get; set; }
    [Parameter] public bool Highlight { get; set; }
}
