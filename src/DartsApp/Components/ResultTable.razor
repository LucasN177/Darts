@* Endergebnis eines Spiels mit den für den Modus relevanten Kennzahlen. *@

<MudSimpleTable Dense="true" Hover="true" Class="result-table">
    <thead>
        <tr>
            <th>#</th>
            <th>Spieler</th>
            @switch (Mode)
            {
                case GameMode.X01:
                case GameMode.SuddenDeath:
                    @if (ShowLegs)
                    {
                        <th class="text-right">@(Settings?.SetsToWin > 1 ? "Sets" : "Legs")</th>
                    }
                    <th class="text-right">Ø</th>
                    <th class="text-right">First 9</th>
                    <th class="text-right">Darts</th>
                    <th class="text-right">Checkout</th>
                    <th class="text-right">Höchstes</th>
                    <th class="text-right">180/140+/100+</th>
                    break;
                case GameMode.Cricket:
                    <th class="text-right">Punkte</th>
                    <th class="text-right">MPR</th>
                    <th class="text-right">Darts</th>
                    break;
                case GameMode.AroundTheClock:
                    <th class="text-right">Ziele</th>
                    <th class="text-right">Darts</th>
                    <th class="text-right">Trefferquote</th>
                    break;
                case GameMode.Checkout121:
                case GameMode.CheckoutRoulette:
                case GameMode.BigFinish:
                    <th class="text-right">Checkouts</th>
                    <th class="text-right">Bestes Ziel</th>
                    <th class="text-right">Darts</th>
                    break;
                case GameMode.Catch40:
                    <th class="text-right">Punkte</th>
                    <th class="text-right">Checkouts</th>
                    <th class="text-right">Darts</th>
                    break;
                case GameMode.Golf:
                    <th class="text-right">Schläge</th>
                    <th class="text-right">Par</th>
                    <th class="text-right">Hole in One</th>
                    break;
                case GameMode.Scram:
                    <th class="text-right">Punkte</th>
                    <th class="text-right">Geschlossen</th>
                    <th class="text-right">Darts</th>
                    break;
                case GameMode.TicTacToe:
                    <th class="text-right">Felder</th>
                    <th class="text-right">Marks</th>
                    <th class="text-right">Darts</th>
                    break;
                case GameMode.Football:
                    <th class="text-right">Tore</th>
                    <th class="text-right">Ballgewinne</th>
                    <th class="text-right">Darts</th>
                    break;
                case GameMode.JdcChallenge:
                    <th class="text-right">Punkte</th>
                    <th class="text-right">Doppel</th>
                    <th class="text-right">Shanghais</th>
                    break;
                case GameMode.ScoringDrill:
                    <th class="text-right">Treffer</th>
                    <th class="text-right">Quote</th>
                    <th class="text-right">Segment</th>
                    <th class="text-right">Ø</th>
                    break;
                case GameMode.HareAndHounds:
                    <th class="text-right">Felder</th>
                    <th class="text-right">Rolle</th>
                    <th class="text-right">Darts</th>
                    break;
                case GameMode.NineLives:
                    <th class="text-right">Fortschritt</th>
                    <th class="text-right">Leben</th>
                    <th class="text-right">Darts</th>
                    break;
                case GameMode.AllFives:
                    <th class="text-right">Punkte</th>
                    <th class="text-right">Wertungen</th>
                    <th class="text-right">Darts</th>
                    break;
                case GameMode.Prisoner:
                    <th class="text-right">Fortschritt</th>
                    <th class="text-right">Befreit</th>
                    <th class="text-right">Gefangen</th>
                    break;
                case GameMode.DoublesLadder:
                    <th class="text-right">Treffer</th>
                    <th class="text-right">Quote</th>
                    <th class="text-right">Darts</th>
                    break;
                case GameMode.BullTraining:
                    <th class="text-right">Punkte</th>
                    <th class="text-right">Bull-Quote</th>
                    <th class="text-right">Darts</th>
                    break;
                case GameMode.Bobs27:
                    <th class="text-right">Punkte</th>
                    <th class="text-right">Treffer</th>
                    <th class="text-right">Quote</th>
                    break;
                case GameMode.Killer:
                    <th class="text-right">Leben</th>
                    <th class="text-right">Kills</th>
                    <th class="text-right">Zahl</th>
                    <th class="text-right">Darts</th>
                    break;
                case GameMode.Baseball:
                    <th class="text-right">Runs</th>
                    <th class="text-right">Trefferquote</th>
                    <th class="text-right">Darts</th>
                    break;
                case GameMode.HalveIt:
                    <th class="text-right">Punkte</th>
                    <th class="text-right">Halbiert</th>
                    <th class="text-right">Darts</th>
                    break;
                case GameMode.Gotcha:
                    <th class="text-right">Punkte</th>
                    <th class="text-right">Gotchas</th>
                    <th class="text-right">Darts</th>
                    break;
                default:
                    <th class="text-right">Punkte</th>
                    <th class="text-right">Ø</th>
                    <th class="text-right">Darts</th>
                    break;
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Results.OrderBy(r => r.Rank).ThenBy(r => r.Position))
        {
            <tr>
                <td>
                    @if (r.IsWinner)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Tertiary" Size="Size.Small" />
                    }
                    else
                    {
                        @r.Rank
                    }
                </td>
                <td>
                    @r.Name
                    @if (r.Extra.ContainsKey("bot"))
                    {
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" Color="Color.Secondary" Style="vertical-align:middle" Title="Computergegner" />
                    }
                </td>
                @switch (Mode)
                {
                    case GameMode.X01:
                    case GameMode.SuddenDeath:
                        @if (ShowLegs)
                        {
                            <td class="text-right">@(Settings?.SetsToWin > 1 ? r.SetsWon : r.LegsWon)</td>
                        }
                        <td class="text-right"><b>@r.Average.ToString("0.00")</b></td>
                        <td class="text-right">@(r.First9Average?.ToString("0.00") ?? "–")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        <td class="text-right">@(r.CheckoutRate is { } rate ? $"{r.CheckoutsHit}/{r.CheckoutAttempts} ({rate:P0})" : "–")</td>
                        <td class="text-right">@r.HighestTurn@(r.HighestCheckout > 0 ? $" / CO {r.HighestCheckout}" : "")</td>
                        <td class="text-right">@r.Count180 / @r.Count140 / @r.Count100</td>
                        break;
                    case GameMode.Cricket:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@Extra(r, "mpr", "0.00")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    case GameMode.AroundTheClock:
                        <td class="text-right"><b>@r.Score / @Extra(r, "targets", "0")</b></td>
                        <td class="text-right">@r.DartsThrown</td>
                        <td class="text-right">@Extra(r, "hit_rate", "P0")</td>
                        break;
                    case GameMode.Checkout121:
                    case GameMode.CheckoutRoulette:
                    case GameMode.BigFinish:
                        <td class="text-right"><b>@r.CheckoutsHit / @r.CheckoutAttempts</b></td>
                        <td class="text-right">@(r.HighestCheckout > 0 ? r.HighestCheckout : "–")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    case GameMode.Catch40:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@r.CheckoutsHit / @r.CheckoutAttempts</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    case GameMode.Golf:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@ToPar(r)</td>
                        <td class="text-right">@Extra(r, "holes_in_one", "0")</td>
                        break;
                    case GameMode.Scram:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@Extra(r, "closed", "0")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    case GameMode.TicTacToe:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@Extra(r, "marks", "0")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    case GameMode.Football:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@Extra(r, "steals", "0")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    case GameMode.JdcChallenge:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@Extra(r, "doubles", "0") / 21</td>
                        <td class="text-right">@Extra(r, "shanghai", "0")</td>
                        break;
                    case GameMode.ScoringDrill:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@Extra(r, "hit_rate", "P1")</td>
                        <td class="text-right">@Extra(r, "segment_rate", "P0")</td>
                        <td class="text-right">@r.Average.ToString("0.00")</td>
                        break;
                    case GameMode.HareAndHounds:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@(Extra(r, "hare", "0") == "1" ? "Hase" : "Hund")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    case GameMode.NineLives:
                        <td class="text-right"><b>@r.Score / 20</b></td>
                        <td class="text-right">@Extra(r, "lives", "0")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    case GameMode.AllFives:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@Extra(r, "scoring_turns", "0")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    case GameMode.Prisoner:
                        <td class="text-right"><b>@r.Score / 20</b></td>
                        <td class="text-right">@Extra(r, "freed", "0")</td>
                        <td class="text-right">@Extra(r, "captured", "0")</td>
                        break;
                    case GameMode.DoublesLadder:
                        <td class="text-right"><b>@r.Score / 21</b></td>
                        <td class="text-right">@Extra(r, "hit_rate", "P1")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    case GameMode.BullTraining:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@Extra(r, "hit_rate", "P1")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    case GameMode.Bobs27:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@r.CheckoutsHit</td>
                        <td class="text-right">@Extra(r, "hit_rate", "P0")</td>
                        break;
                    case GameMode.Killer:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@Extra(r, "kills", "0")</td>
                        <td class="text-right">@Extra(r, "number", "0")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    case GameMode.Baseball:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@Extra(r, "hit_rate", "P0")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    case GameMode.HalveIt:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@Extra(r, "halved", "0")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    case GameMode.Gotcha:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@Extra(r, "knockouts", "0")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                    default:
                        <td class="text-right"><b>@r.Score</b></td>
                        <td class="text-right">@(r.DartsThrown > 0 ? (r.Score * 3.0 / r.DartsThrown).ToString("0.00") : "–")</td>
                        <td class="text-right">@r.DartsThrown</td>
                        break;
                }
            </tr>
        }
    </tbody>
</MudSimpleTable>

@code {
    [Parameter, EditorRequired] public GameMode Mode { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<PlayerResult> Results { get; set; } = [];
    [Parameter] public GameSettings? Settings { get; set; }

    private bool ShowLegs => Settings is { } s && (s.LegsToWin > 1 || s.SetsToWin > 1);

    private static string ToPar(PlayerResult r) =>
        r.Extra.TryGetValue("to_par", out var v) ? (v > 0 ? $"+{v:0}" : v.ToString("0")) : "–";

    private static string Extra(PlayerResult r, string key, string format) =>
        r.Extra.TryGetValue(key, out var v) ? v.ToString(format) : "–";
}
